# Dearly — Environment Variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# Dashboard → Settings → API

# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public URL of this deployment.
# Used as the base for Supabase auth redirect URLs (email confirmation, password reset).
# Local dev: http://localhost:3000
# Production: https://your-domain.com
# Must also be added to: Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
